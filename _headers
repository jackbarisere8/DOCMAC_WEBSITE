# Cloudflare Pages response headers (GitHub Pages ignores this file).
# The live site is hosted on GitHub Pages, which cannot apply these headers.
# Keep this file accurate for a future Cloudflare Pages migration.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:

/releases.json
  Cache-Control: public, max-age=60

/checksums.txt
  Cache-Control: public, max-age=300

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800

/.well-known/security.txt
  Cache-Control: public, max-age=86400
